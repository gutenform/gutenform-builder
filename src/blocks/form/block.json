{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gutenfrom/form",
	"version": "0.1.0",
	"title": "Form",
	"category": "widgets",
	"icon": "smiley",
	"description": "Form Wrapper block for Gutenform.",
	"example": {},
	"attributes": {
		"formTitle": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "gutenform",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}