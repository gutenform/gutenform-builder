{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gutenform/slider",
	"version": "0.1.0",
	"title": "Slider",
	"category": "widgets",
	"icon": "marker",
	"description": "Slider block for Gutenform.",
	"ancestor": ["gutenform/form"],
	"example": {},
	"attributes": {
		"style": { "type": "object", "default": {} },
		"min": { "type": "number", "default": 0 },
		"max": { "type": "number", "default": 100 },
		"step": { "type": "number", "default": 1 },
		"range": { "type": "boolean", "default": false },
		"defaultValueStart": { "type": "number", "default": 0 },
		"defaultValueEnd": { "type": "number", "default": 100 },
		"label": { "type": "string", "default": "" },
		"placeholder": { "type": "string", "default": "" },
		"help": { "type": "string", "default": "" },
		"defaultValue": { "type": "string", "default": "" },
		"required": { "type": "boolean", "default": false },
		"name": { "type": "string", "default": "" },
		"id": { "type": "string", "default": "" },
		"useCustomName": { "type": "boolean", "default": false },
		"useCustomId": { "type": "boolean", "default": false },
		"conditionalShow": { "type": "object", "default": null },
		"orientation": { "type": "string", "default": "horizontal" },
		"direction": { "type": "string", "default": "ltr" },
		"tooltips": { "type": "boolean", "default": false },
		"connect": { "type": "boolean", "default": true },
		"margin": { "type": "number", "default": 0 },
		"limit": { "type": "number", "default": 0 },
		"paddingStart": { "type": "number", "default": 0 },
		"paddingEnd": { "type": "number", "default": 0 },
		"animate": { "type": "boolean", "default": true },
		"animationDuration": { "type": "number", "default": 300 }
	},
	"supports": { "html": false },
	"textdomain": "gutenform",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
