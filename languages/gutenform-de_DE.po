#. Plugin Name of the plugin
#: gutenform-builder.php
msgid "Gutenform Builder"
msgstr "Gutenform Builder"

#. Plugin URI of the plugin
#: gutenform-builder.php
msgid "https://gutenform.de"
msgstr ""

#. Description of the plugin
#: gutenform-builder.php
msgid "A modern WordPress form builder plugin built with Gutenberg blocks. Create beautiful, responsive forms directly in the WordPress block editor and manage all submissions through an intuitive inbox interface. Features an extensible provider system for handling form submissions via email, database, or custom providers."
msgstr "Ein modernes WordPress-Formular-Plugin, das mit Gutenberg-Blöcken erstellt wurde. Erstellen Sie schöne, responsive Formulare direkt im WordPress-Block-Editor und verwalten Sie alle Übermittlungen über eine intuitive Posteingang-Oberfläche. Bietet ein erweiterbares Anbieter-System zur Verarbeitung von Formular-Übermittlungen per E-Mail, Datenbank oder benutzerdefinierten Anbietern."

