{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenform/form",
  "version": "0.1.0",
  "title": "Form",
  "category": "widgets",
  "icon": "smiley",
  "description": "Form Wrapper block for Gutenform.",
  "example": {},
  "attributes": {
    "formTitle": {
      "type": "string",
      "default": ""
    },
    "mailboxId": {
      "type": "string",
      "default": "1"
    },
    "formId": {
      "type": "string",
      "default": ""
    },
    "skin": {
      "type": "string",
      "default": "default"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "gutenform",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}