{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gutenform/textarea",
  "version": "0.1.0",
  "title": "Textarea",
  "category": "widgets",
  "icon": "marker",
  "description": "Textarea block for Gutenform.",
  "example": {},
  "attributes": {
    "style": {
      "type": "object",
      "default": {}
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "help": {
      "type": "string",
      "default": ""
    },
    "defaultValue": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "id": {
      "type": "string",
      "default": ""
    },
    "rows": {
      "type": "number",
      "default": 3
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "gutenform",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}